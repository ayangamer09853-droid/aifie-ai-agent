# ==============================================================================
# AIFIE AUTONOMOUS TRADING AGENT - MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8787
NODE_ENV=production
AIFIE_STATE_PATH=./data/aifie-state.json

# ------------------------------------------------------------------------------
# 2. QUANTUM-RESISTANT SECURITY VAULT (PHASE 8)
# ------------------------------------------------------------------------------
# Master vault password used for AES-256-GCM envelope encryption & key derivation
AIFIE_MASTER_VAULT_KEY=REPLACE_WITH_HIGH_ENTROPY_PASSPHRASE_MIN_32_CHARS
POST_QUANTUM_SECURITY_LEVEL=3  # 1=ML-KEM-512, 3=ML-KEM-768, 5=ML-KEM-1024

# ------------------------------------------------------------------------------
# 3. TRADING EXECUTION & LIVE SAFETY GUARDS (PHASE 2 & 18)
# ------------------------------------------------------------------------------
# STRICT SAFETY: Keep false for 100% Simulated Paper Trading ($100k virtual balance)
ENABLE_LIVE_TRADING=false
LIVE_BROKER_TYPE=alpaca

# Alpaca Markets (US Equities & Options Execution)
APCA_API_KEY_ID=YOUR_ALPACA_KEY_ID
APCA_API_SECRET_KEY=YOUR_ALPACA_SECRET_KEY
APCA_API_BASE_URL=https://paper-api.alpaca.markets  # Switch to https://api.alpaca.markets for real capital

# Binance (Crypto Spot / Futures)
BINANCE_API_KEY=YOUR_BINANCE_API_KEY
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET

# ------------------------------------------------------------------------------
# 4. MARKET DATA FEEDS & CONSENSUS CONNECTORS (WEEKS 1-2)
# ------------------------------------------------------------------------------
IEX_CLOUD_TOKEN=YOUR_IEX_CLOUD_API_TOKEN
POLYGON_API_KEY=YOUR_POLYGON_IO_API_KEY

# ------------------------------------------------------------------------------
# 5. TELEGRAM 1-TAP MOBILE CONFIRMATION GATE (PHASE 6)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_OR_CHANNEL

# ------------------------------------------------------------------------------
# 6. MULTIMODAL VISION & VOICE AI (PHASE 7)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_CLAUDE_3_5_SONNET_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_WHISPER_API_KEY

# ------------------------------------------------------------------------------
# 7. CONSTITUTIONAL RISK INVARIANTS (PHASE 18+)
# ------------------------------------------------------------------------------
MAX_DAILY_LOSS_LIMIT=1000        # Rejects new trades if daily loss >= $1,000
MAX_DRAWDOWN_LIMIT=0.20          # 20% peak-to-trough drawdown circuit breaker
MAX_GROSS_LEVERAGE=2.0           # Maximum leverage allowed
MAX_SINGLE_ASSET_EXPOSURE=0.25   # Max 25% single-asset concentration
MAX_DAILY_ORDERS=1000            # Max 1,000 trade orders per 24 hours
PROFIT_SWEEP_THRESHOLD=10000     # Sweeps 20% profits when daily gains >= $10k
